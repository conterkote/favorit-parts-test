{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/parts.js": {
      "maxDuration": 30,
      "supportsCancellation": true
    },
    "api/resume.js": {
      "maxDuration": 10,
      "includeFiles": "server/files/resume.pdf"
    }
  },
  "rewrites": [
    {
      "source": "/resume.pdf",
      "destination": "/api/resume"
    }
  ]
}
